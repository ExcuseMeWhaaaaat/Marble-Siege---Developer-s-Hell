%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1eb87bd1c28cd449acda7359981c29c, type: 3}
  m_Name: Scene2Interaction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueChunk
  revealNames: 0
  lines:
  - text: 'Hey! Uh, did you get the news? '
    speak: {fileID: 11400000, guid: c2ae27be18ad00f48b1b34cedd44cf61, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 5
  - text: About the potential attack?
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Yes.
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: About that...
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 6
  - text: Its confirmed to no longer be potential...
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 6
  - text: "seoN hO\u2026 "
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 0.176
    charIDRequirement: 4
  - text: Anything else?
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: 'The marble race tycoon event was just postponed until further notice. '
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 6
  - text: 'Does everyone know what''s going on? '
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Yes, everyone is aware.
    speak: {fileID: 11400000, guid: c2ae27be18ad00f48b1b34cedd44cf61, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 5
  - text: Ok good...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Now let's go see him...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: And them...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: There they are!
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 1
  - text: Wait, that sounded like...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Hey there!
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 1
  - text: Oh, hey, we were just talking about-
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Hold on...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: What happened?
    speak: {fileID: 11400000, guid: 8b941eaeefd6c7445ab899bb478c0b17, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 2
  - text: I feel like something is wrong...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Like what?
    speak: {fileID: 11400000, guid: 8b941eaeefd6c7445ab899bb478c0b17, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 2
  - text: I think they're here...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: How many are there!?
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 1
  - text: There's................ only 1?
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Huh, I thought there would be 12 total...
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 1
  - text: Nope, just me!
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
  - text: Wait is that...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: How the heck are you even back!?
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: Yeah, aren't you and your pals not allowed here?
    speak: {fileID: 11400000, guid: 8b941eaeefd6c7445ab899bb478c0b17, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 2
  - text: Wow! Not even a hello or welcome back!?
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
  - text: Also hi, traitor.
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
  - text: Anyways, you taught us a "lesson" so we wanted to return the favor.
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
  - text: Look, We don't know HOW you returned...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: But we NEED you to call this invasion off...
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 4
  - text: "OR what, you\u2019ll have your \u201CPostpone Squad\u201D take on lil'
      ol\u2019 me?\r\n\r\n"
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
  - text: 'Alright then, let''s practice!



'
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
