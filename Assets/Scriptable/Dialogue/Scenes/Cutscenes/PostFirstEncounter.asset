  m_Name: PostFirstEncounter
  m_EditorClassIdentifier: Assembly-CSharp::ChunkDialogue
  lines:
  - text: 'Wait... where did he go!? '
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: And what did he mean by that!?
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: Looks like he's picked up quite a bit from us...
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typeDelay: 1
  - text: Say, where DID your friend go?
    correctID: 9
    speak: {fileID: 11400000, guid: ac5dbfb41c4cb1040acddbd5218753d6, type: 2}
    typeDelay: 1
  - text: 'I think we know where she probably went... '
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typeDelay: 1
  - text: We'll go talk to her and hopefully convince her to help...
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typeDelay: 1
  - text: 'Cosidian''s here, so I guess we''ll go tell EnderSerpent what just happened... '
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
