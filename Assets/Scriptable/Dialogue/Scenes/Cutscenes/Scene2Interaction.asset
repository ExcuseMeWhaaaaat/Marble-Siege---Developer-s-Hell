  m_Script: {fileID: 11500000, guid: d1eb87bd1c28cd449acda7359981c29c, type: 3}
  m_Name: Scene2Interaction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueChunk
  lines:
  - text: 'Hey! did you get the news? '
    correctID: 5
    speak: {fileID: 11400000, guid: c2ae27be18ad00f48b1b34cedd44cf61, type: 2}
  - text: About the potential attack?
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: Yes.
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: About that...
    correctID: 6
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
  - text: Its confirmed to no longer be potential...
    correctID: 6
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
  - text: "seoN hO\u2026 "
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: We should go see those 3.
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: They probably know what the deal is.
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: There they are!
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
  - text: Well, speak of Overlord!
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: Hey there!
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
  - text: Oh, hey, we were just talking about the information you gave us regarding
      the raid.
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: Yeah, thanks for letting us know as always!
    correctID: 6
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
  - text: No problem!
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
  - text: Quick head count...
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: 'Hydrine... Aeri... '
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: 'Wait, where''s the third one? '
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: 'Acyd? She''s probably off listening to her music again... '
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
  - text: 'I''ll go talk to her later... '
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
  - text: I mean....12 raiders shouldn't be too much for us to handle...
    correctID: 2
    speak: {fileID: 11400000, guid: 8b941eaeefd6c7445ab899bb478c0b17, type: 2}
  - text: Yeah, it should be managable...
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: Bet!
    correctID: 7
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
  - text: Wait is that...
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: 'CosmikReaper!?   '
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
  - text: 'Gasp! Its the ringmaster himself! '
    correctID: 2
    speak: {fileID: 11400000, guid: 8b941eaeefd6c7445ab899bb478c0b17, type: 2}
  - text: 'Yeah, its just me for now... '
    correctID: 7
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
  - text: You DO understand that you and your pals were banished for a reason...
      right?
    correctID: 6
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
  - text: Wow! Not even a "hello" or "welcome back"
    correctID: 7
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
  - text: Are you gonna have your "Postpone Squad" take on lil' ol' me?
    correctID: 7
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
  - text: Alright... let's practice
    correctID: 7
    speak: {fileID: 11400000, guid: a700304b2b567094e9506d5f83fc8ed5, type: 2}
