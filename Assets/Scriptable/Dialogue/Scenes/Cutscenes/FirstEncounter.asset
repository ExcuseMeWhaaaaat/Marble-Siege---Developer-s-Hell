  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1eb87bd1c28cd449acda7359981c29c, type: 3}
  m_Name: FirstEncounter
  m_EditorClassIdentifier: Assembly-CSharp::DialogueChunk
  lines:
  - text: "I\u2019ll go notify everyone that these 3 are here."
    correctID: 8
    speak: {fileID: 11400000, guid: 120f42762d3f4ea4981d34094468ca07, type: 2}
    typeDelay: 1
  - text: "See you guys soon\u2026"
    correctID: 8
    speak: {fileID: 11400000, guid: 120f42762d3f4ea4981d34094468ca07, type: 2}
    typeDelay: 1
  - text: "Hey, so\u2026 we just wanted to say sorry we had to meet again under these
      circumstances\u2026\r\n "
    correctID: 1
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typeDelay: 1
  - text: "Eh\u2026 it's not really your fault\u2026"
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: Wait... I just realized...
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: You 3 are... flying?
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: I only know 2 of us around here that can do that...
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: I'm assuming you're Protagon members?
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 1
  - text: Indeed they are!
    correctID: 7
    speak: {fileID: 11400000, guid: af2bfbcd725ab7f4fadc71acc959705d, type: 2}
    typeDelay: 1
  - text: seon hO
    correctID: 4
    speak: {fileID: 11400000, guid: 75c0eb1ef0dab4d4ca5c75fc22c311e7, type: 2}
    typeDelay: 0.5
  - text: Yo can you banish yourself to the shadow realm again please?
    correctID: 6
    speak: {fileID: 11400000, guid: 51104adc72384c849832afd0a84d79fd, type: 2}
    typeDelay: 1
  - text: No can do!
    correctID: 7
    speak: {fileID: 11400000, guid: af2bfbcd725ab7f4fadc71acc959705d, type: 2}
    typeDelay: 1
  - text: So, you brought your entire "Postpone Squad" to take on lil' ol' me?
    correctID: 7
    speak: {fileID: 11400000, guid: af2bfbcd725ab7f4fadc71acc959705d, type: 2}
    typeDelay: 1
  - text: 'And of course, I expected Hydrine & Aeri here but you too Acyd!?  '
    correctID: 7
    speak: {fileID: 11400000, guid: af2bfbcd725ab7f4fadc71acc959705d, type: 2}
    typeDelay: 1
  - text: You know he doesn't like traitors, right?
    correctID: 7
    speak: {fileID: 11400000, guid: af2bfbcd725ab7f4fadc71acc959705d, type: 2}
    typeDelay: 1
  - text: ........................
    correctID: 3
    speak: {fileID: 11400000, guid: 10443583e9eddbb4f862c7d83b067b15, type: 2}
    typeDelay: 1
  - text: Well since you're all here why don't we do a little practice round?
    correctID: 7
    speak: {fileID: 11400000, guid: af2bfbcd725ab7f4fadc71acc959705d, type: 2}
    typeDelay: 1
