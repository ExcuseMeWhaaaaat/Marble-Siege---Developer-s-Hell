  m_Script: {fileID: 11500000, guid: d1eb87bd1c28cd449acda7359981c29c, type: 3}
  m_Name: FirstMeeting
  m_EditorClassIdentifier: Assembly-CSharp::DialogueChunk
  revealNames: 0
  lines:
  - text: '*Knock*'
    speak: {fileID: 11400000, guid: 3adff50d5f5b2574cbc96e1e08be9492, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 8
  - text: OK that should be them...
    speak: {fileID: 11400000, guid: 120f42762d3f4ea4981d34094468ca07, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
  - text: Hey we got the alert that he's here.
    speak: {fileID: 11400000, guid: 120f42762d3f4ea4981d34094468ca07, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 8
  - text: Wait... someone is missing
    speak: {fileID: 11400000, guid: ac5dbfb41c4cb1040acddbd5218753d6, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 8
  - text: 'Say, Hy, where did your friend go? '
    speak: {fileID: 11400000, guid: ac5dbfb41c4cb1040acddbd5218753d6, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 9
  - text: "She probably wants to be left alone for now\u2026"
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 1
  - text: "She\u2019s\u2026 just\u2026 not comfortable yet\u2026"
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 1
  - text: 'And how are you 3 floating?

'
    speak: {fileID: 11400000, guid: b26e30c4c21e91343a9f0aa3f78d8773, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 10
  - text: 'Yeah, only the admins can do that here!

'
    speak: {fileID: 11400000, guid: 8e483e21e4fe87f43bee9eaa667e41de, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 11
  - text: "Oh! We can because we\u2019re\u2026.......... part of Pro-"
    speak: {fileID: 11400000, guid: a1eb5066007f0b34fbbbca8d77b047e1, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 0
  - text: '!!!'
    speak: {fileID: 11400000, guid: 3adff50d5f5b2574cbc96e1e08be9492, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 8
  - text: Shoot, we gotta get moving!
    speak: {fileID: 11400000, guid: 120f42762d3f4ea4981d34094468ca07, type: 2}
    typingSpeed: 0.05
    typingDelay: 1
    charIDRequirement: 7
